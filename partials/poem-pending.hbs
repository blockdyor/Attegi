{{!-- Hide raw poem markers before first paint, including while Rocket Loader
     delays the article bundle beyond native DOMContentLoaded. Observe actual
     script completion in capture phase: Rocket Loader replaces script nodes,
     and resource load/error events do not bubble. --}}
<script data-cfasync="false">
	(function () {
		var pending = [];
		document.querySelectorAll('.post-content blockquote').forEach(function (q) {
			if (/^\s*\[!poem\]/.test(q.textContent)) {
				q.classList.add('kg-poem-pending');
				pending.push(q);
			}
		});
		if (!pending.length) return;
		function revealPending() {
			pending.forEach(function (q) { q.classList.remove('kg-poem-pending'); });
			document.removeEventListener('load', onScriptSettled, true);
			document.removeEventListener('error', onScriptSettled, true);
		}

		function onScriptSettled(event) {
			var script = event.target;
			if (!script || script.tagName !== 'SCRIPT') return;
			if (script.hasAttribute('data-highlight') ||
				(event.type === 'error' && script.hasAttribute('data-cf-settings'))) {
				revealPending();
			}
		}

		document.addEventListener('load', onScriptSettled, true);
		document.addEventListener('error', onScriptSettled, true);
	})();
</script>
